{
  "compilerOptions": {
    "target": "ES2017",
    "module": "ES2015",
    "moduleResolution": "node",
    "lib": ["ES2017", "DOM"],
    "outDir": "dist/esm",
    "declaration": true,
    "declarationDir": "dist/types",
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "removeComments": false,
    "sourceMap": false
  },
  "include": ["src/**/*.ts"]
}